# Optional: only required for live Claude judgments.
ANTHROPIC_API_KEY=

# The default model used by the live judge.
MERGE_GATE_MODEL=claude-haiku-4-5

# Optional for public PRs; required for private PRs. Use read-only permissions.
GITHUB_TOKEN=

# Optional: a shared organization baseline policy the repository overlay can
# tighten but not weaken. Leave MERGE_GATE_ORG_POLICY_REPO unset to run with
# the repository policy alone. See docs/policy-guide.md.
MERGE_GATE_ORG_POLICY_REPO=
MERGE_GATE_ORG_POLICY_REF=main
MERGE_GATE_ORG_POLICY_PATH=.merge-gate/organization.toml
